# Role Fit Environment Configuration

# Database connection.
# SQLite is used for local development. The path is relative to the project
# root because Prisma ORM 7 driver adapters resolve it from the working directory.
DATABASE_URL="file:./prisma/dev.db"

# AI Provider Configuration
# Supported providers: "mock" (built-in deterministic offline extractor),
# "ollama" (local open-weight LLM).
# These are bootstrap/fallback values. The runtime configuration lives in the
# WorkspaceSettings database row and is managed from /settings.
AI_PROVIDER="mock"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Application
NEXT_PUBLIC_APP_NAME="Role Fit"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
