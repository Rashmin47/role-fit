# Role Fit Environment Configuration

# Database Connection (Supports PostgreSQL or local SQLite for testing)
DATABASE_URL="file:./dev.db"

# AI Provider Configuration
# Supported providers: "mock" (built-in offline simulator), "ollama" (local LLM), "custom"
AI_PROVIDER="mock"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Application
NEXT_PUBLIC_APP_NAME="Role Fit"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
